APP_NAME="Dulank API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dulank
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: daftar origin frontend (dipisah koma)
FRONTEND_URLS="http://localhost:3000,http://localhost:3001"

# Path sumber data mock frontend (untuk `php artisan dulank:import`)
DULANK_STORE_PATH="/path/to/dulank-store"
DULANK_ADMIN_PATH="/path/to/dulank-admin"

# Sanctum: umur token (menit), kosong = tanpa kedaluwarsa
SANCTUM_TOKEN_EXPIRATION=null

# Akun admin awal (dipakai AdminUserSeeder)
DULANK_ADMIN_EMAIL=admin@dulank.test
DULANK_ADMIN_PASSWORD=admin12345

# Password awal user store hasil impor
DULANK_IMPORT_PASSWORD=password

# Override tarif pajak default & disk upload (opsional)
DULANK_TAX_RATE=11
DULANK_UPLOAD_DISK=public
DULANK_UPLOAD_MAX_KB=4096
